{
  "name": "dsh-codex-timeline",
  "version": "0.6.0",
  "description": "Search, favorites, branching, and personalization for the official DeepSeek Harness turn navigator",
  "homepage": "https://github.com/Wine-Red/dsh-codex-timeline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wine-Red/dsh-codex-timeline.git"
  },
  "bugs": {
    "url": "https://github.com/Wine-Red/dsh-codex-timeline/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dshCodexTimeline": {
    "verifiedDshVersion": "0.1.2-alpha.3",
    "verifiedDshVersions": [
      "0.1.2-alpha.3"
    ],
    "insertsRow": "codex-timeline",
    "compatibilityMode": "official-navigation-enhancer"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "node scripts/prepare-dist.mjs && node scripts/verify-dist.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run format && pnpm run test && pnpm run build",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "conversation",
    "timeline",
    "navigation",
    "search",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.3",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
